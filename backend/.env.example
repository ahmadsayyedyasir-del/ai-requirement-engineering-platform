# =============================================================================
# backend/.env.example
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env — it is listed in .gitignore.
# In production (Railway / Render) paste these as Environment Variables
# in the dashboard — do NOT upload a .env file to the server.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────

# Set to "production" on any deployed environment.
# Development mode enables verbose SQL logging — never use in production.
ENVIRONMENT=development

# Print every SQL query to the console.
# MUST be false in production — logs may leak sensitive data.
DEBUG=false

# JWT signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Keep this secret — anyone who has it can forge login tokens.
SECRET_KEY=replace-with-a-64-char-random-hex-string

# How long a login session lasts (minutes). Default = 24 hours.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS / Frontend URL ───────────────────────────────────────────────────────

# The public URL of your deployed frontend (e.g. Vercel).
# The backend adds this to its CORS allowed-origins list so the browser
# does not block API calls from your frontend domain.
# Example: https://your-app.vercel.app
# Leave empty for local Docker dev (localhost origins are always allowed).
FRONTEND_URL=https://your-app.vercel.app

# ── LLM Provider ─────────────────────────────────────────────────────────────

# Which AI provider to use for ALL generation tasks.
# "groq"   → Groq API  (DEFAULT — fast, free tier available)
# "openai" → OpenAI API (GPT-4o — higher quality, paid)
#
# IMPORTANT: The README mentions GPT-4o but the actual default wired up
# in llm_client.py is GROQ (llama-3.3-70b-versatile).
# Set LLM_PROVIDER=openai and fill OPENAI_API_KEY to switch to GPT-4o.
LLM_PROVIDER=groq

# ── Groq (default provider) ───────────────────────────────────────────────────

# Groq API key — get a FREE key at https://console.groq.com
# Format starts with: gsk_
# Required when LLM_PROVIDER=groq
GROQ_API_KEY=gsk-your-groq-api-key-here

# Groq model. Options (fastest to highest quality):
#   llama-3.1-8b-instant      — very fast, lower quality
#   llama-3.3-70b-versatile   — recommended (default) — best JSON output
#   mixtral-8x7b-32768        — good for very long documents
GROQ_MODEL=llama-3.3-70b-versatile

# ── OpenAI (alternative provider + embeddings) ───────────────────────────────

# OpenAI API key — get one at https://platform.openai.com/api-keys
# Required when LLM_PROVIDER=openai.
# Also used for ChromaDB RAG embeddings even when LLM_PROVIDER=groq.
# If empty and LLM_PROVIDER=groq, embeddings fall back to a local model
# (no OpenAI cost, but lower RAG quality).
OPENAI_API_KEY=

# Chat model — only used when LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o

# Embedding model for ChromaDB RAG (used whenever OPENAI_API_KEY is set)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────

# Full asyncpg connection string.
# Local Docker:  postgresql+asyncpg://reqeng:reqeng_pass@db:5432/reqeng_db
# Railway:       Copy the "Postgres Connection URL" from the Railway dashboard
#                and change "postgresql://" → "postgresql+asyncpg://"
# Render:        Render auto-injects DATABASE_URL — same substitution needed.
DATABASE_URL=postgresql+asyncpg://reqeng:reqeng_pass@db:5432/reqeng_db

# ── Redis ─────────────────────────────────────────────────────────────────────

# Redis connection string.
# Local Docker:  redis://redis:6379/0
# Railway/Render: copy the Redis connection URL from the service dashboard.
REDIS_URL=redis://redis:6379/0

# ── Celery (background task queue) ───────────────────────────────────────────

# Celery broker — where task messages are sent.
# Use Redis database 1 to keep it separate from the main app cache.
CELERY_BROKER_URL=redis://redis:6379/1

# Celery result backend — where completed task results are stored.
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── ChromaDB (vector store for RAG) ──────────────────────────────────────────

# Hostname of the ChromaDB server.
# Local Docker: chroma   (service name in docker-compose.yml)
# Production:   hostname of your ChromaDB Render service, or Chroma Cloud host
CHROMA_HOST=chroma

# ChromaDB HTTP port.
# Local Docker: 8000  (mapped to 8001 on the host machine)
# Production:   8000 (or whatever port your hosted ChromaDB listens on)
CHROMA_PORT=8000

# ── File Uploads ─────────────────────────────────────────────────────────────

# Directory where uploaded PDF/DOCX files are stored.
# In Docker this is a named volume (survives container restarts).
# In production on Railway/Render, /tmp is ephemeral — files are lost on restart.
# For persistent uploads in production, integrate S3 / Cloudflare R2 instead.
UPLOAD_DIR=/tmp/req_uploads

# Max upload size in megabytes.
MAX_UPLOAD_SIZE_MB=50
