# =============================================================================
# frontend/.env.example
# Copy this file to frontend/.env.local for local development.
# For production, paste these as Environment Variables in the Vercel dashboard
# — do NOT commit .env.local.
#
# Vite environment variable rules:
#   - Variable names MUST start with VITE_ to be accessible in the browser.
#   - Values are baked in at BUILD TIME — changing them requires a redeploy.
#   - Use the Vercel dashboard to set production values before each deploy.
# =============================================================================

# ── API Base URL ──────────────────────────────────────────────────────────────

# The public URL of the deployed FastAPI backend.
# Vercel frontend calls this URL for every API request.
#
# LOCAL DEVELOPMENT:
#   Leave this EMPTY. Vite's dev server proxy (vite.config.js) automatically
#   forwards /api/... requests to http://localhost:8000.
#   No env var needed — the proxy handles it.
#
# PRODUCTION (Vercel):
#   Set this to your Railway or Render backend URL in the Vercel dashboard.
#   Example: https://reqeng-api.railway.app
#   Example: https://reqeng-api.onrender.com
#   DO NOT include a trailing slash.
VITE_API_URL=https://your-backend-url.railway.app

# ── Optional: App Name override ───────────────────────────────────────────────

# Shown in the browser tab title and any "powered by" text.
# Defaults to "AI Requirement Engineering Platform" if not set.
# VITE_APP_NAME=ReqAI Platform
